# Copy to .env.production on the server. Never commit the real file.
# Use URL-safe letters and numbers for these passwords because MYSQL_PASSWORD
# is also embedded in DATABASE_URL by docker-compose.demo.yml.
MYSQL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

DASHSCOPE_API_KEY=YOUR_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional provider-neutral settings take precedence over the legacy DashScope names.
LLM_API_KEY=
LLM_API_KEY_B64=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
# Optional one-call analysis + interview model; deployment does not enable it by default.
LLM_TURN_MODEL=
LLM_TURN_PARALLEL=false
LLM_TURN_STRATEGY=race
# Optional second model, e.g. qwen3.7-plus; increases per-call cost.
LLM_TURN_SECONDARY_MODEL=
# Optional dedicated nonthinking model for grounded drafts.
LLM_DRAFT_MODEL=

# Set to your HTTPS hostname if deploying a different server.
ALLOWED_HOSTS=localhost,127.0.0.1,47.82.83.74,aimemory.47-82-83-74.nip.io
MEDIA_ROOT=/data/media
