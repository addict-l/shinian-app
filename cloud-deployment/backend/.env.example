# Keep this file free of real credentials. Copy to .env and supply your own key.
# For the isolated Mac setup, scripts/bootstrap_database.py writes DATABASE_URL to .env.local.
DATABASE_URL=mysql+pymysql://ai_memories:CHANGE_ME@127.0.0.1:3307/ai_memories_local?charset=utf8mb4
DASHSCOPE_API_KEY=YOUR_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional provider-neutral settings take precedence over the legacy DashScope names.
LLM_API_KEY=
LLM_API_KEY_B64=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
# Optional fast analysis + interview reply; empty preserves two-call behavior.
# Compare with real latency/quality tests before enabling (e.g. qwen3.7-flash).
LLM_TURN_MODEL=
# Parallel validated turns improve latency at the cost of additional calls.
LLM_TURN_PARALLEL=false
# race: two complete candidates; parallel_tasks: analysis + interview in parallel.
LLM_TURN_STRATEGY=race
# Optional second model for parallel turns; empty uses LLM_TURN_MODEL twice.
LLM_TURN_SECONDARY_MODEL=
# Optional nonthinking grounded-draft model, independent of ordinary replies.
LLM_DRAFT_MODEL=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MEDIA_ROOT=.runtime/media
# Default local mode is unchanged. OSS is accessed only by the authenticated backend.
MEDIA_STORAGE=local
OSS_BUCKET=
OSS_REGION=cn-hongkong
OSS_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
OSS_PREFIX=media/
# Retain active local copies during rollout so the previous backend can recover.
OSS_LOCAL_MIRROR=true
# Only NoSuchKey may fall back to a legacy local photo; access/network errors do not.
OSS_LOCAL_FALLBACK=true
# Mount a protected dotenv file containing OSS_ACCESS_KEY_ID and OSS_ACCESS_KEY_SECRET.
OSS_CREDENTIALS_FILE=
