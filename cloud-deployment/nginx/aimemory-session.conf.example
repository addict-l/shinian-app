# Install only with the family-session backend and updated iOS client.
# This file belongs in Nginx's http context (for example sites-enabled).
limit_req_zone $binary_remote_addr zone=shinian_auth:1m rate=10r/m;

server {
    listen 80;
    server_name aimemory.47-82-83-74.nip.io;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name aimemory.47-82-83-74.nip.io;
    ssl_certificate /etc/letsencrypt/live/aimemory.47-82-83-74.nip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aimemory.47-82-83-74.nip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 10m;

    # Authentication and family ownership are enforced by the API.
    # Overwrite client-supplied forwarding headers for reliable IP throttling.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 10s;
    proxy_read_timeout 450s;
    proxy_send_timeout 180s;

    location ~ ^/api/v1/auth/(login|register)$ {
        limit_req zone=shinian_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
