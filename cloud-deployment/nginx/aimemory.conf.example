# Example only. Set your own hostname/certificate paths before installing.
# Credentials file and certificate private key stay outside Git.
server {
    listen 80;
    server_name aimemory.47-82-83-74.nip.io;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name aimemory.47-82-83-74.nip.io;
    ssl_certificate /etc/letsencrypt/live/aimemory.47-82-83-74.nip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aimemory.47-82-83-74.nip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    auth_basic "Shinian Family";
    auth_basic_user_file /etc/nginx/shinian.htpasswd;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
